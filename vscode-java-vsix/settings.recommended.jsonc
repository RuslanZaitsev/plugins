// Рекомендуемые настройки VS Code для Java/Spring/Maven/Kafka/proto в закрытом контуре (доступ только к Nexus).
// Скопировать в User settings.json: Ctrl+Shift+P -> Preferences: Open User Settings (JSON).
// Строки с <...> заменить на реальные пути. Остальное можно брать как есть.
{
  // ---------- JDK ----------
  // JDK для языкового сервера Java (JDT LS). Нужна 21+, независимо от версии проекта (SberJDK 25 подходит).
  "java.jdt.ls.java.home": "<C:\\Program Files\\SberJDK\\25.3.001>",
  // Spring Tools тоже нужна Java 21+. Без этой строки берётся java из PATH, и при 17 сервер Spring не стартует.
  "spring-boot.ls.java.home": "<C:\\Program Files\\SberJDK\\25.3.001>",
  // JDK, под которые компилируются проекты. default: true — для проектов без явного release/target.
  "java.configuration.runtimes": [
    { "name": "JavaSE-17", "path": "<C:\\Program Files\\Java\\jdk-17>", "default": true },
    { "name": "JavaSE-21", "path": "<C:\\Program Files\\Java\\jdk-21>" }
  ],
  // Память языковому серверу: на больших многомодульных проектах дефолта (1G) мало.
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms200m -Xlog:disable",

  // ---------- Maven (всё через Nexus по вашему settings.xml) ----------
  // Тот же settings.xml, с которым работает mvn в консоли: в нём зеркало на Nexus.
  "java.configuration.maven.userSettings": "<C:\\Work\\.m2\\settings.xml>",
  "maven.executable.path": "<C:\\Program Files (x86)\\apache-maven-3.9.6\\bin\\mvn.cmd>",
  "java.maven.downloadSources": true,
  "java.eclipse.downloadSources": true,
  "java.import.maven.enabled": true,
  // Обновлять classpath при изменении pom.xml без вопроса.
  "java.configuration.updateBuildConfiguration": "automatic",
  // Не создавать .project/.classpath в корне модулей: с ними модуль импортируется как Eclipse-проект
  // в обход Maven (ошибка 1013, пропадают proto-классы и навигация). Это значение по умолчанию, но пусть будет явно.
  "java.import.generatesMetadataFilesAtProjectRoot": false,
  // Gradle-проекты: дистрибутив качается по distributionUrl из gradle-wrapper.properties.
  // Если там services.gradle.org, а не Nexus, импорт Gradle не пройдёт. Для Maven-проектов не важно.
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,

  // proto-классы: настраивать ничего не нужно. Это делает расширение local.m2e-protobuf.
  // java.configuration.maven.lifecycleMappings и java.jdt.ls.protobufSupport.enabled для этого не нужны.

  // ---------- Оффлайн: отключить всё, что ходит в интернет ----------
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,
  // Также защищает от автообновления redhat.java: более новые версии ломают lombok (см. README).
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  // Иначе YAML-расширение тянет каталог схем со schemastore.org, и запросы висят.
  "yaml.schemaStore.enable": false,
  // XML-расширение не должно скачивать DTD/XSD из интернета.
  "xml.downloadExternalResources.enabled": false,
  "java.help.firstView": "none",
  "java.help.showReleaseNotes": false,
  // Баннер про Copilot modernization / older Java runtime.
  "java.dependency.enableDependencyCheckup": false,
  // Облачные функции GitLens (аккаунт GitKraken) в закрытом контуре не работают — скрыть.
  "gitlens.plusFeatures.enabled": false,

  // ---------- Формат и удобство (ближе к IDEA) ----------
  "editor.formatOnSave": true,
  // Форматировать только изменённые строки. Иначе форматтер Eclipse переформатирует весь файл,
  // и в коммит, который читают коллеги из IDEA, попадёт огромный дифф.
  "editor.formatOnSaveMode": "modifications",
  "java.saveActions.organizeImports": true,
  "java.completion.importOrder": ["java", "javax", "jakarta", "org", "com", ""],
  "java.sources.organizeImports.starThreshold": 99,
  "java.sources.organizeImports.staticStarThreshold": 99,
  "java.inlayHints.parameterNames.enabled": "literals",
  "java.references.includeDecompiledSources": true,
  "workbench.editor.enablePreview": false,

  // ---------- YAML ----------
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml", "editor.tabSize": 2 },
  // Автодополнение в application.yml даёт Spring Tools из classpath проекта, интернет не нужен.

  // ---------- Proto / gRPC ----------
  // bufbuild.vscode-buf: распаковать buf-Windows-x86_64-v1.73.0.zip из набора, например в C:\tools.
  // Если не распаковывать, удалите эту строку: подсветку .proto останется давать zxh404.vscode-proto3.
  "buf.commandLine.path": "<C:\\tools\\buf\\bin\\buf.exe>",

  // ---------- Kafka ----------
  // Кластеры лучше держать в настройках проекта (.vscode/settings.json), а не в User.
  // "kafka.clusters": [ { "name": "dev", "bootstrap": "<kafka-dev:9092>" } ],

  // ---------- Терминал ----------
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
