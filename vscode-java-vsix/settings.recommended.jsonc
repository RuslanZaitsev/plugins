// Рекомендуемые настройки VS Code для Java/Spring/Kafka/proto в закрытом контуре.
// Скопировать нужное в User settings.json (Ctrl+Shift+P -> Preferences: Open User Settings (JSON)).
// Пути под Windows — заменить на реальные.
{
  // ---------- JDK ----------
  // JDK, на котором запускается сам языковой сервер (JDT LS). Нужен 21+, независимо от версии проекта.
  "java.jdt.ls.java.home": "C:\\Program Files\\Java\\jdk-21",
  // JDK, против которых компилируются проекты. default: true — для проектов без явного release.
  "java.configuration.runtimes": [
    { "name": "JavaSE-17", "path": "C:\\Program Files\\Java\\jdk-17", "default": true },
    { "name": "JavaSE-21", "path": "C:\\Program Files\\Java\\jdk-21" }
  ],
  // Памяти языковому серверу: на монорепе с сотнями модулей дефолта мало.
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms200m -Xlog:disable",

  // ---------- Maven ----------
  "java.configuration.maven.userSettings": "C:\\Users\\<user>\\.m2\\settings.xml",
  "java.configuration.maven.globalSettings": "C:\\Users\\<user>\\.m2\\settings.xml",
  "maven.executable.path": "C:\\tools\\apache-maven\\bin\\mvn.cmd",
  "java.maven.downloadSources": true,
  "java.eclipse.downloadSources": true,
  // Импорт без onlineresolution — артефакты берутся из локального репозитория и Nexus по settings.xml.
  "java.import.maven.enabled": true,
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,

  // ---------- Оффлайн: заглушить всё, что лезет наружу ----------
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  // YAML-расширение по умолчанию тянет каталог схем с schemastore.org — в закрытом контуре это висящие запросы.
  "yaml.schemaStore.enable": false,
  // XML-расширение не должен ходить за DTD/XSD в интернет.
  "xml.downloadExternalResources.enabled": false,
  "java.help.firstView": "none",
  "java.help.showReleaseNotes": false,
  // Баннер "This project is using an older Java runtime (17)... install GitHub Copilot modernization":
  // это dependency checkup из vscjava.vscode-java-dependency. Кнопка Later откладывает лишь на 10 дней.
  "java.dependency.enableDependencyCheckup": false,
  // Не предлагать ставить расширения из Marketplace, которого всё равно нет.
  "extensions.ignoreRecommendations": true,

  // ---------- Формат/удобство (ближе к IDEA) ----------
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "java.saveActions.organizeImports": true,
  "java.completion.importOrder": ["java", "javax", "jakarta", "org", "com", ""],
  "java.sources.organizeImports.starThreshold": 99,
  "java.sources.organizeImports.staticStarThreshold": 99,
  "java.inlayHints.parameterNames.enabled": "literals",
  "java.references.includeDecompiledSources": true,
  "editor.inlineSuggest.enabled": true,
  "workbench.editor.enablePreview": false,

  // ---------- YAML ----------
  "yaml.format.enable": true,
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml", "editor.tabSize": 2 },
  // Схемы application.yml подтягиваются Spring Boot Tools автоматически из classpath проекта.

  // ---------- Proto / gRPC ----------
  // buf по умолчанию скачивает себя с GitHub — в закрытом контуре положить бинарник руками и указать путь.
  "buf.path": "C:\\tools\\buf\\buf.exe",
  "buf.checkUpdates": false,
  // Если buf недоступен — останется zxh404.vscode-proto3 (подсветка + go-to-definition по import path):
  "protoc": {
    "path": "C:\\tools\\protoc\\bin\\protoc.exe",
    "options": ["--proto_path=src/main/proto"]
  },

  // ---------- Kafka ----------
  // Кластеры удобнее держать в workspace-настройках проекта, а не в User.
  // "kafka.clusters": [ { "name": "dev", "bootstrap": "kafka-dev:9092" } ],


  // ---------- SQL (PostgreSQL) ----------
  // Подключения задаются через SQLTools UI; драйвер pg ставится отдельным .vsix.

  // ---------- Терминал ----------
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
